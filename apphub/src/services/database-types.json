{
    "postgresql": {
        "images": [
            "postgres",
            "pgvector",
            "paradedb",
            "timescale",
            "supabase/postgres"
        ],
        "host": "",
        "port": 5432,
        "url": "postgres://${users[*].user}:${users[*].password}@${host}:${port}/${name}",
        "name": [
            "${POSTGRES_DB}"
        ],
        "users": [
            {
                "user": "${POSTGRES_USER}",
                "password": "${POSTGRES_PASSWORD}"
            }
        ]
    },
