        "name": [
            "${MYSQL_DATABASE}"
        ],
        "users": [
            {
                "user": "root",
                "password": "${MYSQL_ROOT_PASSWORD}",
                "usage": [
                    "administration"
                ]
            },
            {
                "user": "${MYSQL_USER}",
                "password": "${MYSQL_PASSWORD}",
                "usage": [
                    "application"
                ]
            }
        ]
    },
